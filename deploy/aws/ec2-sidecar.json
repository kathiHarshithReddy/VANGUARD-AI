# ─── AWS EC2 Sidecar Container Pattern ──────────────────────────────────────
#
# Deploys VANGUARD as a sidecar container alongside your application container
# using AWS ECS Task Definition.  Replace <YOUR_ORIGIN_PORT> and account IDs.
#
# Deploy:
#   aws ecs register-task-definition --cli-input-json file://ec2-sidecar.json

{
  "family": "vanguard-sidecar",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["EC2"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "vanguard",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/vanguard:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "ORIGIN_URL",                  "value": "http://localhost:<YOUR_ORIGIN_PORT>" },
        { "name": "PROXY_PORT",                  "value": "8080" },
        { "name": "ENTROPY_BENIGN_THRESHOLD",    "value": "0.45" },
        { "name": "ENTROPY_BLOCK_CONFIDENCE",    "value": "0.85" },
        { "name": "DOJO_PAYLOADS_PER_MINUTE",    "value": "1000" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:8080/healthz')\" || exit 1"],
        "interval": 15,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/vanguard",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "linuxParameters": {
        "capabilities": {
          "drop": ["ALL"],
          "add": ["NET_BIND_SERVICE"]
        }
      },
      "readonlyRootFilesystem": false,
      "privileged": false,
      "user": "vanguard"
    },
    {
      "name": "origin-app",
      "image": "<YOUR_APP_IMAGE>",
      "essential": true,
      "portMappings": [
        { "containerPort": "<YOUR_ORIGIN_PORT>", "protocol": "tcp" }
      ],
      "dependsOn": [
        { "containerName": "vanguard", "condition": "HEALTHY" }
      ]
    }
  ]
}
